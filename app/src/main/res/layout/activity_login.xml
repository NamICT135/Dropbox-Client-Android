<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/login_title" android:textSize="28sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/demo_notice" />
        <EditText android:id="@+id/demo_username" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp"
            android:hint="@string/demo_username" android:inputType="text|textNoSuggestions"
            android:autofillHints="username" android:maxLength="24" android:singleLine="true" />
        <EditText android:id="@+id/demo_password" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:hint="@string/demo_password" android:inputType="textPassword"
            android:importantForAutofill="no" android:saveEnabled="false" android:maxLength="128" android:singleLine="true" />
        <TextView android:id="@+id/login_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/demo_login_help" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/button_continue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/demo_login" />
        <Button android:id="@+id/button_register" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/demo_register" />
    </LinearLayout>
</ScrollView>
