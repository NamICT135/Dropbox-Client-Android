<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/account_info" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:textSize="18sp"
        android:text="@string/account_loading" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/account_retry" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/account_retry" />
    <Button android:id="@+id/account_logout" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/logout" />
</LinearLayout>
