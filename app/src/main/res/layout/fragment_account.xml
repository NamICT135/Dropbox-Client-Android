<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/account_title" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/account_subtitle"
            android:textColor="@color/text_muted" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="20dp"
            app:strokeColor="@color/panel_outline" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/account_local_heading" android:textColor="?attr/colorPrimary" android:textStyle="bold" />
                <TextView android:id="@+id/demo_account" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/demo_shared_storage"
                    android:textColor="@color/text_muted" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="20dp"
            app:strokeColor="@color/panel_outline" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/account_cloud_heading" android:textSize="20sp" android:textStyle="bold" />
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/account_progress"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:indeterminate="true" />
                <TextView android:id="@+id/account_info" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/account_loading" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/account_connected_note"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/account_connected_note"
                    android:textColor="@color/text_muted" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/account_retry"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/account_retry" />
                <com.google.android.material.button.MaterialButton android:id="@+id/account_connect"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:text="@string/project_setup" />
                <com.google.android.material.button.MaterialButton android:id="@+id/account_disconnect"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="56dp" android:visibility="gone"
                    android:text="@string/project_disconnect" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/account_logout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginTop="16dp" android:text="@string/account_logout"
            android:textColor="@color/status_error" />
    </LinearLayout>
</ScrollView>
